<Window x:Class="OpenServerOps.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenServerOps" Width="1240" Height="800" MinWidth="1000" MinHeight="650" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="OpenServerOps" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/><TextBlock Text="Server operations, without the guesswork." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Local-first health checks, logs, backups, and addon audits." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL ONLY  ·  NO TELEMETRY" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,28,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE SERVER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ServerName" Text="No server selected" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ServerPath" Text="Choose a local server folder to begin." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="DarkMode" Content="Dark" VerticalAlignment="Center" Margin="0,0,12,0" Click="DarkMode_Click"/><Button x:Name="ChooseServer" Content="Choose server" Click="ChooseServer_Click"/><Button x:Name="RunChecks" Content="Run checks" Click="RunChecks_Click" Background="{StaticResource Blue}" Foreground="White"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Overview" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Evidence from the selected server folder." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SERVER STATE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StateText" Text="Not checked" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LAST CHECK" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LastCheck" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FINDINGS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FindingCount" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid><Separator Background="{StaticResource Line}"/><TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,16,0,7"/><TextBox x:Name="Activity" VerticalScrollBarVisibility="Auto" Height="142" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"/></StackPanel></Border><TextBlock Text="LOG FILES" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,16,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LogFilter" Height="32" VerticalContentAlignment="Center" TextChanged="LogFilter_TextChanged" ToolTip="Filter discovered log files"/><Button Grid.Column="1" Content="Clear" Click="ClearLogFilter_Click" Margin="8,0,0,0"/></Grid><ListBox x:Name="LogList" Height="92" Margin="0,8,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Checks" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Read-only checks first. Changes stay explicit." Foreground="{StaticResource Muted}" Margin="0,4,0,14"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="HEALTH" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HealthResult" TextWrapping="Wrap" Text="Waiting for a server." FontSize="16" FontWeight="SemiBold" Margin="0,6,0,18"/><TextBlock Text="STORAGE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StorageResult" TextWrapping="Wrap" Text="—" FontSize="15" Margin="0,6,0,18"/><TextBlock Text="ADDONS · LOGS · WORKSHOP" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AddonResult" TextWrapping="Wrap" Text="—" FontSize="15" Margin="0,6,0,18"/><TextBlock Text="BACKUP ARCHIVES" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BackupResult" TextWrapping="Wrap" Text="—" FontSize="15"/></StackPanel></Border></StackPanel></Grid>
    <Grid Grid.Row="3" Margin="0,20,0,0"><TextBlock Text="OpenServerOps 2.0.0  ·  Read-only operations console  ·  MIT licensed" Foreground="{StaticResource Muted}" FontSize="12"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="ExportJson" Content="Export JSON" Click="ExportJson_Click" IsEnabled="False"/><Button x:Name="ExportHtml" Content="Export HTML report" Click="ExportHtml_Click" IsEnabled="False" Margin="0"/></StackPanel></Grid>
  </Grid>
</Window>
