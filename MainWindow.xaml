<Window x:Class="OpenServerOps.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenServerOps" Width="1240" Height="780" MinWidth="1000" MinHeight="650" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0"><StackPanel><TextBlock Text="OpenServerOps" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/><TextBlock Text="Server operations, without the guesswork." FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Local-first health checks, logs, backups, and addon audits." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/></StackPanel><TextBlock Text="LOCAL ONLY  ·  NO TELEMETRY" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource Muted}" FontSize="11"/></Grid>
    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,28,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ACTIVE SERVER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="ServerName" Text="No server selected" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="ServerPath" Text="Choose a local server folder to begin." Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Choose server" Click="ChooseServer_Click"/><Button Content="Run checks" Click="RunChecks_Click" Background="{StaticResource Blue}" Foreground="White"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,14,0"><TextBlock Text="Overview" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="What is happening on the selected server." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SERVER STATE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StateText" Text="Not checked" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="LAST CHECK" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="LastCheck" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FINDINGS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FindingCount" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid><Separator Background="{StaticResource Line}"/><TextBlock Text="RECENT ACTIVITY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="0,18,0,7"/><TextBox x:Name="Activity" Height="170" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel>
    <StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Checks" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Read-only checks first. Changes stay explicit." Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="HEALTH" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HealthResult" Text="Waiting for a server." FontSize="16" FontWeight="SemiBold" Margin="0,6,0,18"/><TextBlock Text="STORAGE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="StorageResult" Text="—" FontSize="15" Margin="0,6,0,18"/><TextBlock Text="ADDONS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AddonResult" Text="—" FontSize="15" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></Grid>
    <TextBlock Grid.Row="3" Text="OpenServerOps 0.1.0  ·  Read-only foundation  ·  MIT licensed" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0"/>
  </Grid>
</Window>
