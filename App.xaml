<Application x:Class="OpenServerOps.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#F4F6F8"/><SolidColorBrush x:Key="Panel" Color="#FFFFFF"/><SolidColorBrush x:Key="Line" Color="#D8E0E8"/><SolidColorBrush x:Key="Text" Color="#17212B"/><SolidColorBrush x:Key="Muted" Color="#667586"/><SolidColorBrush x:Key="Blue" Color="#2563D9"/><SolidColorBrush x:Key="Green" Color="#16845B"/><SolidColorBrush x:Key="Amber" Color="#A66A00"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Application.Resources>
</Application>
